# .env.example: a template listing every setting the platform reads.
# Copy it to .env (which git ignores) and fill in real values there. Never commit .env.

# --- LLM (pick one provider) ---
LLM_PROVIDER=ollama            # ollama | mistral | gemini | anthropic
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
MISTRAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Vector store ---
QDRANT_URL=http://localhost:6333

# --- Graph store ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# --- Tracing ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Tools (used from step 5 on) ---
GITHUB_TOKEN=
GOOGLE_CALENDAR_CREDENTIALS=
SEARCH_API_KEY=

# Eval judge (a different model family from the answer model)
GROQ_API_KEY=
